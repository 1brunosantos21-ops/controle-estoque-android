<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:padding="24dp" android:gravity="center"
    android:background="#F5F7FA" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:text="📦  Controle de Estoque" android:textSize="26sp" android:textStyle="bold"
        android:textColor="#0B1F3A" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:text="Conecte o aplicativo ao seu sistema" android:textSize="16sp"
        android:textColor="#5F6B7A" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <EditText android:id="@+id/urlInput" android:hint="https://seu-servidor.com" android:inputType="textUri"
        android:singleLine="true" android:padding="14dp" android:layout_marginTop="28dp"
        android:background="#FFFFFF" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/connectButton" android:text="Conectar" android:textAllCaps="false"
        android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:text="Você poderá alterar o endereço depois nas configurações do aplicativo."
        android:textSize="13sp" android:textColor="#687385" android:gravity="center"
        android:layout_marginTop="16dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
</LinearLayout>
